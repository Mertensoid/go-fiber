package widgets

import "go-fiber/internal/vacancy"
import "go-fiber/views/layout"
import "go-fiber/views/components"

templ VacancyList(vacancies []vacancy.Vacancy) {
    @VacancyListStyle()
    <div class="vacancy-list-wrapper">
        <div class="vacancy-list-header">
            @components.FormTitle("Опубликовать вакансию")
            @components.FormSubtitle("Введите все необходимые данные для публикации")
        </div>
        <div class="vacancy-list">
            for _, vacancy := range vacancies {
                    @layout.VacancyCard(layout.VacancyCardProps{
                        Role: vacancy.Role,
                        Company: vacancy.Company,
                        Sphere: vacancy.Sphere,
                        Salary: vacancy.Salary,
                        Email: vacancy.Email,
                        Location: vacancy.Location,
                        Ceratedat: vacancy.CreatedAt,
                    })
                }
        </div>
    </div>
}

templ VacancyListStyle() {
    <style>
        .vacancy-list-wrapper {
            background-color: white;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .vacancy-list {
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: white;
            width: 90%;
            max-width: 1296px;
            gap: 24px;
            padding-bottom: 60px;
        }
        .vacancy-list-header {
            width: 90%;
            max-width: 1296px;
            display: flex;
            flex-direction: column;
            background-color: white;
            margin: 60px 0;
            gap: 40px;
        }
    </style>
}