package widgets

import "go-fiber/views/components"

templ LoginForm() {
    @LoginFormStyle()
    <div class="login-widget">
        @components.Title("Войти на сайт")
        @components.Subtitle("Войдите под своей учётной записью")
        <form class="login-form">
            @components.Input(components.InputProps{
                Placeholder: "Email",
                Name: "email",
            })
            @components.Input(components.InputProps{
                Placeholder: "Пароль",
                Name: "password",
            })
            @components.SubmitButton() {
                Войти на сайт
            }
        </form>
    </div>
}

templ LoginFormStyle() {
    <style>
        .login-widget {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            margin-bottom: 80px;
        }
        .login-form {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 30px;
        }
    </style>
}