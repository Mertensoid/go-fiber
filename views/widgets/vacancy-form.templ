package widgets

import "go-fiber/views/components"

templ VacancyForm() {
    @VacancyFormStyle()
    <div class="main__submit-form">
                @components.FormTitle("Опубликовать вакансию")
                <div class="vacancy-result" id="vacancy-result"></div>
                @components.FormSubtitle("Введите все необходимые данные для публикации")
                <div >
                    <form class="input-grid" hx-post="/vacancy" hx-trigger="submit" hx-target="#vacancy-result" hx-swap="innerHTML">
                    
                        @components.Input(components.InputProps{
                            Name: "role",
                            Placeholder: "Должность",
                        })
                        @components.Input(components.InputProps{
                            Name: "company",
                            Placeholder: "Название компании",
                        })
                        @components.Input(components.InputProps{
                            Name: "sphere",
                            Placeholder: "Сфера компании",
                        })
                        @components.Input(components.InputProps{
                            Name: "salary",
                            Placeholder: "Заработная плата",
                        })
                        @components.Input(components.InputProps{
                            Name: "location",
                            Placeholder: "Расположение",
                        })
                        @components.Input(components.InputProps{
                            Name: "email",
                            Placeholder: "Контактный e-mail",
                        })
                        @components.SubmitButton() {
                            <span>Опубликовать вакансию</span>
                        }
                    
                    </form>
                </div>  
            </div>
}

templ VacancyFormStyle() {
    <style>
        .main__submit-form {
            max-width: 880px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .input-grid {
            
            display: grid;
            grid-auto-flow: row;
            grid-template-columns: 435px 435px;
            grid-template-rows: repeat(4, 80px);
            column-gap: 10px;
            row-gap: 10px;
        }
        .vacancy-result {
            width: 100%;
        }
    </style>
}