package layout

templ Header() {
    @HeaderStyle()
    <div class="header">
        @Menu()
        { children...}
    </div>
}

templ HeaderStyle() {
    <style>
        .header {
            background: #222222;
            width: 100%;
            display: flex;
            justify-content: center;
            flex-direction: column;
            align-items: center;
        }
    </style>
}