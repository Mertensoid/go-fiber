package components

templ FormTitle(title string) {
    @FormTitleStyle()
    <h1 class="form-title">
        {title}
    </h1>
    
}

templ FormTitleStyle() {
    <style>
    .form-title {
        font-size: 40px;
        color: var(--color-black);
        font-weight: bold;
        margin-bottom: 40px;
        margin-top: 0px;
    }
    </style>
}