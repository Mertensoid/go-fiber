package components

templ Notification(message string) {
    @NotificationStyle()
    <div class="notification notification_success">
        {message}
    </div>
}

templ NotificationStyle() {
    <style>
        .notification {
            width: 100%;
            height: 80px;
            font-size: 16px;
            color: var(--color-white);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        .notification_success {
            background-color: rgb(33, 212, 152);
        }
    </style>
}