package components

type TitleProps struct {
    Title string
}

css titleClass() {
    font-size: { "70px" };
    color: { "#FFFFFF" };
    font-width: { "bold" };
    margin-bottom: { "12px" };
    margin-top: { "0px" };
}

templ Title(props TitleProps) {
    <h1 class={titleClass()}>
        {props.Title}
    </h1>
    
}